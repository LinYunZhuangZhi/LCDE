--- !u!114 &2145171248
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2145171245}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u8BE5\u7F16\u8F91\u5668\u76EE\u524D\u662F\u534A\u6210\u54C1\uFF0C\u5982\u679C\u6709\u6539\u8FDB\u5EFA\u8BAE\u6216bug\u53CD\u9988\u8BF7\u8054\u7CFBQQ\u7FA4663707173\u3002\n\u4F7F\u7528\u65F6\uFF0C\u8BF7\u5148\u5728\u4E3B\u9875\u9762\u7ED9\u5B9A\u8DEF\u5F84\u7684Character\u6587\u4EF6\u5939\u4E0B\u521B\u5EFA\u81EA\u5DF1\u5C06\u8981\u4F7F\u7528\u7684\u89D2\u8272\u7684\u6587\u4EF6\u5939\uFF0C\u800C\u540E\u5728\u8BE5\u6587\u4EF6\u5939\u653E\u5165\u89D2\u8272\u5DEE\u5206\uFF08\u624B\u673A\u7AEF\u89C1\u6559\u7A0B\uFF09\uFF0C\u518D\u5728\u4E3B\u9875\u9762\u7F16\u8F91\u89D2\u8272\u91CC\u5728\u8BE5\u6587\u4EF6\u5939\u4E0B\u65B0\u5EFA\u4E00\u4E2A\u914D\u7F6E\u6587\u4EF6\uFF0C\u5982\u679C\u9700\u8981\u5934\u50CF\u5219\u5728Character/Head\u6587\u4EF6\u5939\u4E0B\u521B\u5EFA\u4E0E\u89D2\u8272\u6587\u4EF6\u5939\u540C\u540D\u7684\u56FE\u7247\u3002\u80CC\u666F\u53EA\u9700\u8981\u5728BG\u6587\u4EF6\u5939\u4E0B\u5B58\u653E\u56FE\u7247\u5373\u53EF\u3002\u5EFA\u8BAE\u4F7F\u7528PNG\u6587\u4EF6\uFF0C\u6709\u4E9B\u6587\u4EF6\u65E0\u6CD5\u8BFB\u53D6\u3002\u8F6C\u6362\u683C\u5F0F\u8BF7\u4F7F\u7528\u8F6C\u683C\u5F0F\u5DE5\u5177\uFF0C\u4E0D\u8981\u76F4\u63A5\u6539\u540E\u7F00\u3002\u7F16\u8F91\u754C\u9762\u53F3\u4E0B\u89D2\u6709\u4E00\u4E2A\u4E0B\u62C9\u5217\u8868\u548C\u65B0\u5EFA\u6309\u94AE\uFF0C\u6240\u6709\u65B0\u5EFA\u6309\u94AE\u90FD\u4F1A\u65B0\u5EFA\u4E0B\u62C9\u5217\u8868\u9009\u62E9\u7684\u547D\u4EE4\u7C7B\u578B\uFF0C\u4E0B\u62C9\u5217\u8868\u53EF\u4EE5\u5207\u6362\u547D\u4EE4\u7C7B\u578B\u3002\u70B9\u51FB\u6307\u4EE4\u65F6\u4F1A\u64AD\u653E\u9884\u89C8\u3002\n\u7F16\u8F91\u6A21\u5F0F\u7684\u7ACB\u7ED8\u5217\u8868\u4E0D\u662F\u6309\u94AE\uFF0C\u8BF7\u5728\u4E0B\u65B9\u8F93\u5165\u6846\u8F93\u5165\u76F8\u5E94\u7684\u7ACB\u7ED8\u7F16\u53F7\u3002\uFF08\u6216\u8BB8\u540E\u7EED\u4F1A\u6539\uFF09\n\u7EC4\u547D\u4EE4\uFF1A\u4E00\u4E2A\u5185\u90E8\u5305\u542B\u591A\u4E2A\u547D\u4EE4\u7684\u547D\u4EE4\uFF0C\u8FD8\u672A\u6D4B\u8BD5\u662F\u5426\u6709bug\uFF0C\u4F46\u663E\u7136\u6709bug\uFF0C\u4E0D\u8981\u5728\u4E00\u4E2A\u547D\u4EE4\u7EC4\u4E0B\u5305\u542B\u591A\u4E2ASay\u4E0EWaitClick\uFF0C\u4E0D\u8981\u5728\u547D\u4EE4\u7EC4\u4E0B\u7684\u547D\u4EE4\u7EC4\u5305\u542BSay\u4E0EWaitClick\uFF0C\u7EC4\u5185CInCOut\u6709\u7F16\u8F91\u4E0A\u7684Bug\u3002\u540C\u6B65\uFF08Synchronization\uFF09\u4F1A\u5C06\u81EA\u8EAB\u5305\u542B\u7684\u547D\u4EE4\u540C\u65F6\u6267\u884C\uFF0C\u76EE\u7684\u662F\u8BA9\u4EBA\u7269\u8BF4\u8BDD\u65F6\u540C\u65F6\u884C\u52A8\u6216\u505A\u591A\u4E2A\u52A8\u4F5C\u3002\u961F\u5217\uFF08Queue\uFF09\u4F1A\u5C06\u81EA\u8EAB\u5305\u542B\u7684\u547D\u4EE4\u6309\u987A\u5E8F\u6267\u884C\uFF0C\u53EF\u4EE5\u7528\u6765\u5728\u540C\u6B65\u4E0B\u8BA9\u4E00\u4E2A\u89D2\u8272\u8BF4\u8BDD\u65F6\u79FB\u8FC7\u53BB\u53C8\u79FB\u56DE\u6765\u4E4B\u7C7B\u7684\u3002\n\u8BF4\u8BDD\uFF1A\u5728\u4E0B\u65B9\u9762\u677F\u9010\u5B57\u663E\u793A\u51FA\u4E00\u53E5\u8BDD\uFF0C\u663E\u793A\u8FC7\u7A0B\u4E2D\u70B9\u51FB\u5C06\u7ACB\u523B\u663E\u793A\u6240\u6709\u5185\u5BB9\uFF0C\u663E\u793A\u5B8C\u540E\u4E0B\u6B21\u70B9\u51FB\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\u5185\u5BB9\u652F\u6301\u5BCC\u6587\u672C\u3002\u53EF\u4EE5\u9009\u62E9\u6587\u672C\u663E\u793A\u4F4D\u7F6E\u4EE5\u53CA\u662F\u5426\u9690\u85CF\u5176\u4ED6\u89D2\u8272\n\u7B49\u5F85\u70B9\u51FB\uFF1A\u70B9\u51FB\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\uFF0C\u6CA1\u7528\u3002\n\u7B49\u5F85\u79D2\u6570\uFF1A\u7B49\u5F85\u4E00\u6BB5\u65F6\u95F4\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u89D2\u8272\u7ACB\u7ED8\uFF1A\u66F4\u6539\u5728\u573A\u89D2\u8272\u7ACB\u7ED8\uFF0C\u7ACB\u523B\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u89D2\u8272\u8FDB\u5165\uFF1A\u8BA9\u4E00\u4E2A\u89D2\u8272\u5728\u6307\u5B9A\u4F4D\u7F6E\u5165\u573A\uFF0C\u65F6\u95F4\u4E3A\u96F6\u5219\u7ACB\u523B\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\uFF0C\u5426\u5219\u5165\u573A\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u89D2\u8272\u8DF3\u8DC3\uFF1A\u8BA9\u4E00\u4E2A\u89D2\u8272\u539F\u5730\u8DF3\u8D77\u843D\u4E0B\u6216\u8DF3\u8D77\u4E0D\u843D\u4E0B\uFF0C\u6267\u884C\u5B8C\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u89D2\u8272\u79FB\u52A8\uFF1A\u8BA9\u4E00\u4E2A\u89D2\u8272\u4ECE\u4E00\u4E2A\u4F4D\u7F6E\u79FB\u5230\u53E6\u4E00\u4E2A\u4F4D\u7F6E\uFF0C\u65F6\u95F4\u4E3A\u96F6\u5219\u7ACB\u523B\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\uFF0C\u5426\u5219\u79FB\u52A8\u5B8C\u6210\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u89D2\u8272\u9000\u51FA\uFF1A\u8BA9\u4E00\u4E2A\u89D2\u8272\u9000\u573A\uFF0C\u65F6\u95F4\u4E3A\u96F6\u5219\u7ACB\u523B\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\uFF0C\u5426\u5219\u9000\u573A\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u89D2\u8272\u9707\u52A8\uFF1A\u8BA9\u4E00\u4E2A\u89D2\u8272\u9707\u52A8\uFF0C\u4E0D\u8981\u628A\u65F6\u95F4\u8BBE\u4E3A\u96F6\uFF0C\u6267\u884C\u5B8C\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u5207\u6362\u80CC\u666F\uFF1A\u7ACB\u523B\u5207\u6362\u80CC\u666F\uFF0C\u7ACB\u523B\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u80CC\u666F\u6DE1\u5165\u6DE1\u51FA/\u6DE1\u5165/\u6DE1\u51FA\uFF1A\u80CC\u666F\u6DE1\u51FA\u5207\u6362\u80CC\u666F\uFF0C\u7136\u540E\u6DE1\u5165\u3002\u80CC\u666F\u6DE1\u51FA\u5207\u6362\u80CC\u666F\u7136\u540E\u6DE1\u5165\uFF0C\u6267\u884C\u5B8C\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u80CC\u666F\u6E10\u53D8\uFF1A\u80CC\u666F\u6E10\u53D8\u6210\u53E6\u4E00\u4E2A\u80CC\u666F\uFF0C\u6267\u884C\u5B8C\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u80CC\u666F\u540D\u79F0\uFF1A\u5207\u6362\u5DE6\u4E0A\u89D2\u663E\u793A\u540D\u79F0\uFF0C\u82E5\u4E3A\u7A7A\u5219\u9690\u85CF\uFF0C\u7ACB\u523B\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u80CC\u666F\u79FB\u52A8\uFF1A\u8BA9\u4E00\u4E2A\u80CC\u666F\u4ECE\u4E00\u4E2A\u4F4D\u7F6E\u79FB\u5230\u53E6\u4E00\u4E2A\u4F4D\u7F6E\uFF0C\u65F6\u95F4\u4E3A\u96F6\u5219\u7ACB\u523B\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\uFF0C\u5426\u5219\u79FB\u52A8\u5B8C\u6210\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\u6CE8\u610F\u79FB\u52A8\u7684\u662F\u56FE\u7247\u7684\u4F4D\u7F6E\u4E0D\u662F\u6444\u50CF\u5934\u7684\u4F4D\u7F6E\u3002\u8DDF\u968F\u89D2\u8272\u4E0E\u4E0D\u8DDF\u968F\u89D2\u8272\u79FB\u52A8\u5728\u80CC\u666F\u4E0A\u4F1A\u53E0\u52A0\u3002\n\u80CC\u666F\u7F29\u653E\uFF1A\u8BA9\u4E00\u4E2A\u80CC\u666F\u4ECE\u4E00\u4E2A\u7F29\u653E\u5230\u53E6\u6539\u4E00\u4E2A\u7F29\u653E\uFF0C\u65F6\u95F4\u4E3A\u96F6\u5219\u7ACB\u523B\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\uFF0C\u5426\u5219\u7F29\u653E\u5B8C\u6210\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\u8DDF\u968F\u89D2\u8272\u4E0E\u4E0D\u8DDF\u968F\u89D2\u8272\u7F29\u653E\u5728\u80CC\u666F\u4E0A\u4F1A\u53E0\u52A0\u3002\n\u80CC\u666F\u4F4D\u7F6E/\u65CB\u8F6C/\u7F29\u653E\u9707\u52A8\uFF1A\u80CC\u666F\u9707\u52A8\uFF0C\u9707\u52A8\u5B8C\u540E\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u80CC\u666F\u97F3\u4E50\uFF1A\u4FEE\u6539\u80CC\u666F\u97F3\u4E50\uFF0C\u8DEF\u5F84\u4E3A\u7A7A\u5219\u6539\u4E3A\u65E0\u97F3\u4E50\uFF0C\u7ACB\u523B\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u97F3\u6548\uFF1A\u64AD\u653E\u4E00\u4E2A\u97F3\u6548\uFF0C\u7ACB\u523B\u6267\u884C\u4E0B\u4E2A\u6307\u4EE4\u3002\n\u89D2\u8272\u524D\u7F6E\uFF1A\u5C06\u4E00\u4E2A\u89D2\u8272\u56FE\u5C42\u79FB\u5230\u6700\u524D\u65B9\u3002\n\u89D2\u8272\u8868\u60C5\uFF1A\u8BA9\u4E00\u4E2A\u89D2\u8272\u663E\u793A\u8868\u60C5\u3002\n\n\n"
